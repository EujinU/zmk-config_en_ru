#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

// Home row mods macro
#define HRML(k2,k3,k4) &ht LALT k2  &ht LCTRL k3  &ht LGUI k4
#define HRMR(k1,k2,k3) &ht RGUI k1  &ht RCTRL k2  &ht RALT k3
#define WHRML(k2,k3,k4) &ht LALT k2  &ht LGUI k3  &ht LCTRL k4
#define WHRMR(k1,k2,k3) &ht RCTRL k1  &ht RGUI k2  &ht RALT k3

#define EN_WIN 0
#define EN_RIG 1
#define EN_LEF 2
#define EN_TRI 3
#define RU_WIN 4
#define RU_RIG 5
#define RU_LEF 6
#define RU_TRI 7

/ {
    behaviors {
        ht: hold_tap {
            label = "hold_tap";
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <220>;
            quick-tap-ms = <150>;
            global-quick-tap;
            bindings = <&kp>, <&kp>;
        };

        layout_switch: layout_switch {
            compatible = "zmk,behavior-macro";
            label = "LAYOUT_SWITCH";
            #binding-cells = <0>;
            bindings = <
                &macro_press &kp LSHFT &kp LCTRL
                &macro_pause_for 50
                &macro_release &kp LSHFT &kp LCTRL
                &macro_tap &to RU_WIN
            >;
        };

        layout_reset: layout_reset {
            compatible = "zmk,behavior-macro";
            label = "LAYOUT_RESET";
            #binding-cells = <0>;
            bindings = <
                &macro_press &kp LSHFT &kp LCTRL
                &macro_pause_for 50
                &macro_release &kp LSHFT &kp LCTRL
                &macro_tap &to EN_WIN
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        en_tri_layer {
            if-layers = <EN_RIG EN_LEF>;
            then-layer = <EN_TRI>;
        };
        ru_tri_layer {
            if-layers = <RU_RIG RU_LEF>;
            then-layer = <RU_TRI>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ====================================================================================================== Английская раскладка ======================================================================================================

        // ============= EN - Основной слой =============
        en_win_layer {bindings = <
        //╭─────────────────────┬─────────────────────┬─────────────────────┬─────────────────────┬─────────────────────╮   ╭─────────────────────┬─────────────────────┬─────────────────────┬─────────────────────┬─────────────────────╮
        //│          Q          │          W          │          E          │          R          │          T          │   │          Y          │          U          │          I          │          O          │          P          │
                   &kp Q                 &kp W                 &kp E                 &kp R                 &kp T                     &kp Y                 &kp U                 &kp I                 &kp O                 &kp P
        //├─────────────────────┼─────────────────────┼─────────────────────┼─────────────────────┼─────────────────────┤   ├─────────────────────┼─────────────────────┼─────────────────────┼─────────────────────┼─────────────────────┤
        //│          A          │          S          │          D          │          F          │          G          │   │          H          │          J          │          K          │          L          │        BSPC         │
                  &kp A                                     WHRML(S, D, F)                                 &kp G                     &kp H                                    WHRMR(J, K, L)                               &kp BSPC
        //├─────────────────────┼─────────────────────┼─────────────────────┼─────────────────────┼─────────────────────┤   ├─────────────────────┼─────────────────────┼─────────────────────┼─────────────────────┼─────────────────────┤
        //│          Z          │          X          │          C          │          V          │          B          │   │          N          │          M          │         , <         │         . >         │        ENTER        │
                   &kp Z                 &kp X                 &kp C                 &kp V                 &kp B                     &kp N                 &kp M               &kp COMMA              &kp DOT              &kp ENTER
        //╰─────────────────────┴─────────────────────┴─────────────────────┼─────────────────────┼─────────────────────┤   ├─────────────────────┼─────────────────────┼─────────────────────┴─────────────────────┴─────────────────────╯
                                                                                 &lt EN_LEF TAB          &kp LSHIFT               &kp SPACE            &lt EN_RIG TAB
        //                                                                  ╰─────────────────────┴─────────────────────╯   ╰─────────────────────┴─────────────────────╯
            >;
        };

        // ============= EN - Правый слой =============
        en_right_layer {bindings = <
        //╭─────────────────────┬─────────────────────┬─────────────────────┬─────────────────────┬─────────────────────╮   ╭─────────────────────┬─────────────────────┬─────────────────────┬─────────────────────┬─────────────────────╮
        //│          1          │          2          │          3          │          4          │          5          │   │          6          │          7          │          8          │          9          │          0          │
                  &kp N1                &kp N2                &kp N3                 &kp N4               &kp N5                    &kp N6                &kp N7                &kp N8                &kp N9                &kp N0
        //├─────────────────────┼─────────────────────┼─────────────────────┼─────────────────────┼─────────────────────┤   ├─────────────────────┼─────────────────────┼─────────────────────┼─────────────────────┼─────────────────────┤
        //│                     │      CAPSLOCK       │      PRINTSCR       │       INSERT        │                     │   │      PAGE UP        │        LEFT         │         UP          │        RIGHT        │       DELETE        │
                  &trans               &kp CAPS             &kp PSCRN               &kp INS               &trans                  &kp PG_UP              &kp LEFT               &kp UP               &kp RIGHT              &kp DEL
        //├─────────────────────┼─────────────────────┼─────────────────────┼─────────────────────┼─────────────────────┤   ├─────────────────────┼─────────────────────┼─────────────────────┼─────────────────────┼─────────────────────┤
        //│                     │                     │                     │                     │                     │   │      PAGE DOWN      │        HOME         │        DOWN         │         END         │         ESC         │
                  &trans                &trans                &trans                &trans                &trans                   &kp PG_DN             &kp HOME              &kp DOWN               &kp END               &kp ESC
        //╰─────────────────────┴─────────────────────┴─────────────────────┼─────────────────────┼─────────────────────┤   ├─────────────────────┼─────────────────────┼─────────────────────┴─────────────────────┴─────────────────────╯
                                                                                      &trans               &trans                   &trans               &trans
        //                                                                  ╰─────────────────────┴─────────────────────╯   ╰─────────────────────┴─────────────────────╯
            >;
        };

        // ============= EN - Левый слой =============
        en_left_layer {bindings = <
        //╭─────────────────────┬─────────────────────┬─────────────────────┬─────────────────────┬─────────────────────╮   ╭─────────────────────┬─────────────────────┬─────────────────────┬─────────────────────┬─────────────────────╮
        //│          !          │          @          │          #          │          $          │          %          │   │          ^          │          &          │          *          │          `          │          ~          │
                 &kp EXCL               &kp AT               &kp HASH              &kp DLLR              &kp PRCNT                 &kp CARET              &kp AMPS             &kp ASTRK             &kp GRAVE             &kp TILDE
        //├─────────────────────┼─────────────────────┼─────────────────────┼─────────────────────┼─────────────────────┤   ├─────────────────────┼─────────────────────┼─────────────────────┼─────────────────────┼─────────────────────┤
        //│          "          │          [          │          {          │          (          │                     │   │          /          │          +          │          -          │          :          │          ;          │
                  &kp DQT              &kp LBKT              &kp LBRC               &kp LPAR               &trans                   &kp FSLH              &kp PLUS              &kp MINUS            &kp COLON              &kp SEMI
        //├─────────────────────┼─────────────────────┼─────────────────────┼─────────────────────┼─────────────────────┤   ├─────────────────────┼─────────────────────┼─────────────────────┼─────────────────────┼─────────────────────┤
        //│          '          │          ]          │          }          │          )          │                     │   │          \          │          =          │          _          │          |          │         ?           │
                  &kp SQT              &kp RBKT              &kp RBRC              &kp RPAR                &trans                   &kp BSLH              &kp EQUAL             &kp UNDER             &kp PIPE              &kp QMARK
        //╰─────────────────────┴─────────────────────┴─────────────────────┼─────────────────────┼─────────────────────┤   ├─────────────────────┼─────────────────────┼─────────────────────┴─────────────────────┴─────────────────────╯
                                                                                     &trans                &trans                    &trans                &trans
        //                                                                  ╰─────────────────────┴─────────────────────╯   ╰─────────────────────┴─────────────────────╯
            >;
        };

        // ============= EN - Двойной слой =============
        en_tri_layer {bindings = <
        //╭─────────────────────┬─────────────────────┬─────────────────────┬─────────────────────┬─────────────────────╮   ╭─────────────────────┬─────────────────────┬─────────────────────┬─────────────────────┬─────────────────────╮
        //│         F1          │         F2          │         F3          │         F4          │      PROFILE 0      │   │      PROFILE 3      │      TOGGLEOUT      │         WIN         │       VOL UP        │      NEXT SONG      │
                  &kp F1                &kp F2                &kp F3                &kp F4              &bt BT_SEL 0             &bt BT_SEL 3          &out OUT_TOG           &tog EN_WIN          &kp C_VOL_UP           &kp C_NEXT
        //├─────────────────────┼─────────────────────┼─────────────────────┼─────────────────────┼─────────────────────┤   ├─────────────────────┼─────────────────────┼─────────────────────┼─────────────────────┼─────────────────────┤
        //│         F5          │         F6          │         F7          │         F8          │      PROFILE 1      │   │      PROFILE 4      │     INC BRIGHT      │                     │       VOL MUTE      │     PAUSE/MUTE      │
                  &kp F5                &kp F6                &kp F7                &kp F8              &bt BT_SEL 1             &bt BT_SEL 4          &kp C_BRI_UP              &trans              &kp C_MUTE            &kp C_PP
        //├─────────────────────┼─────────────────────┼─────────────────────┼─────────────────────┼─────────────────────┤   ├─────────────────────┼─────────────────────┼─────────────────────┼─────────────────────┼─────────────────────┤
        //│         F9          │         F10         │         F11         │         F12         │      PROFILE 2      │   │      CLEAR BT       │     DEC BRIGHT      │                     │      VOL DOWN       │      PREV SONG      │
                  &kp F9                &kp F10              &kp F11                &kp F12            &bt BT_SEL 2               &bt BT_CLR           &kp C_BRI_DEC             &trans              &kp C_VOL_DN          &kp C_PREV
        //╰─────────────────────┴─────────────────────┴─────────────────────┼─────────────────────┼─────────────────────┤   ├─────────────────────┼─────────────────────┼─────────────────────┴─────────────────────┴─────────────────────╯
                                                                                     &trans               &trans                     &trans                &trans
        //                                                                  ╰─────────────────────┴─────────────────────╯   ╰─────────────────────┴─────────────────────╯
            >;
        };



        // ======================================================================================================= Русская раскладка =======================================================================================================
        // ============= RU - Основной слой =============
       ru_win_layer {bindings = <
//╭─────────────────────┬─────────────────────┬─────────────────────┬─────────────────────┬─────────────────────╮   ╭─────────────────────┬─────────────────────┬─────────────────────┬─────────────────────┬─────────────────────╮
//│          Й          │          Ц          │          У          │          К          │          Е          │   │          Н          │          Г          │          Ш          │          Щ          │          З          │
&kp CYRILLIC_SHORTI &kp CYRILLIC_TSHE &kp CYRILLIC_U &kp CYRILLIC_KA &kp CYRILLIC_IE &kp CYRILLIC_EN &kp CYRILLIC_GHE &kp CYRILLIC_SHA &kp CYRILLIC_SHCHA &kp CYRILLIC_ZE
//├─────────────────────┼─────────────────────┼─────────────────────┼─────────────────────┼─────────────────────┤   ├─────────────────────┼─────────────────────┼─────────────────────┼─────────────────────┼─────────────────────┤
//│          Ф          │          Ы          │          В          │          А          │          П          │   │          Р          │          О          │          Л          │          Д          │        BSPC         │
&kp CYRILLIC_EF &kp CYRILLIC_YERU &kp CYRILLIC_VE &kp CYRILLIC_A &kp CYRILLIC_PE &kp CYRILLIC_ER &kp CYRILLIC_O &kp CYRILLIC_EL &kp CYRILLIC_DE &kp BSPC
//├─────────────────────┼─────────────────────┼─────────────────────┼─────────────────────┼─────────────────────┤   ├─────────────────────┼─────────────────────┼─────────────────────┼─────────────────────┼─────────────────────┤
//│          Я          │          Ч          │          С          │          М          │          И          │   │          Т          │          Б          │         , <         │         . >         │        ENTER        │
&kp CYRILLIC_YA &kp CYRILLIC_CHE &kp CYRILLIC_ES &kp CYRILLIC_EM &kp CYRILLIC_I &kp CYRILLIC_TE &kp CYRILLIC_BE &kp COMMA &kp DOT &kp ENTER
//╰─────────────────────┴─────────────────────┴─────────────────────┼─────────────────────┼─────────────────────┤   ├─────────────────────┼─────────────────────┼─────────────────────┴─────────────────────┴─────────────────────╯
                                                                        &lt RU_LEF TAB &kp LSHIFT &kp SPACE &lt RU_RIG TAB
//                                                                  ╰─────────────────────┴─────────────────────╯   ╰─────────────────────┴─────────────────────╯
>;
};

        // ============= RU - Правый слой =============
        ru_right_layer {bindings = <
        //╭─────────────────────┬─────────────────────┬─────────────────────┬─────────────────────┬─────────────────────╮   ╭─────────────────────┬─────────────────────┬─────────────────────┬─────────────────────┬─────────────────────╮
        //│          1          │          2          │          3          │          4          │          5          │   │          6          │          7          │          8          │          9          │          0          │
                  &kp N1                &kp N2                &kp N3                &kp N4                &kp N5                    &kp N6                &kp N7                &kp N8                &kp N9                 &kp N0
        //├─────────────────────┼─────────────────────┼─────────────────────┼─────────────────────┼─────────────────────┤   ├─────────────────────┼─────────────────────┼─────────────────────┼─────────────────────┼─────────────────────┤
        //│          Ь          │       CAPSLOCK      │      PRINTSCR       │        INSERT       │                     │   │      PAGE UP        │        LEFT         │         UP          │        RIGHT        │       DELETE        │
           &kp CYRILLIC_SOFT_SIGN       &kp CAPS             &kp PSCRN              &kp INS               &trans                  &kp PG_UP              &kp LEFT               &kp UP               &kp RIGHT              &kp DEL
        //├─────────────────────┼─────────────────────┼─────────────────────┼─────────────────────┼─────────────────────┤   ├─────────────────────┼─────────────────────┼─────────────────────┼─────────────────────┼─────────────────────┤
        //│          Ъ          │                     │                     │                     │                     │   │      PAGE DOWN      │         HOME        │        DOWN         │         END         │         ESC         │
           &kp CYRILLIC_HARD_SIGN        &trans                &trans                 &trans               &trans                  &kp PG_DN              &kp HOME             &kp DOWN               &kp END               &kp ESC
        //╰─────────────────────┴─────────────────────┴─────────────────────┼─────────────────────┼─────────────────────┤   ├─────────────────────┼─────────────────────┼─────────────────────┴─────────────────────┴─────────────────────╯
                                                                                     &trans               &trans                     &trans               &trans
        //                                                                  ╰─────────────────────┴─────────────────────╯   ╰─────────────────────┴─────────────────────╯
            >;
        };

        // ============= RU - Левый слой =============
        ru_left_layer {bindings = <
        //╭─────────────────────┬─────────────────────┬─────────────────────┬─────────────────────┬─────────────────────╮   ╭─────────────────────┬─────────────────────┬─────────────────────┬─────────────────────┬─────────────────────╮
        //│          !          │          @          │          #          │          $          │          %          │   │          ^          │          &          │          *          │          `          │          ~          │
                  &kp EXCL               &kp AT               &kp HASH             &kp DLLR              &kp PRCNT                 &kp CARET              &kp AMPS             &kp ASTRK             &kp GRAVE             &kp TILDE
        //├─────────────────────┼─────────────────────┼─────────────────────┼─────────────────────┼─────────────────────┤   ├─────────────────────┼─────────────────────┼─────────────────────┼─────────────────────┼─────────────────────┤
        //│          "          │          [          │          {          │          (          │                     │   │          /          │          +          │          -          │          :          │          ;          │
                  &kp DQT               &kp LBKT              &kp LBRC             &kp LPAR                &trans                   &kp FSLH              &kp PLUS             &kp MINUS             &kp COLON             &kp SEMI
        //├─────────────────────┼─────────────────────┼─────────────────────┼─────────────────────┼─────────────────────┤   ├─────────────────────┼─────────────────────┼─────────────────────┼─────────────────────┼─────────────────────┤
        //│          '          │          ]          │          }          │          )          │                     │   │          \          │          =          │          _          │          |          │          ?          │
                  &kp SQT               &kp RBKT              &kp RBRC             &kp RPAR                &trans                   &kp BSLH              &kp EQUAL            &kp UNDER              &kp PIPE             &kp QMARK
        //╰─────────────────────┴─────────────────────┴─────────────────────┼─────────────────────┼─────────────────────┤   ├─────────────────────┼─────────────────────┼─────────────────────┴─────────────────────┴─────────────────────╯
                                                                                     &trans                &trans                    &trans                &trans
        //                                                                  ╰─────────────────────┴─────────────────────╯   ╰─────────────────────┴─────────────────────╯
            >;
        };

        // ============= RU - Двойной слой =============
        ru_tri_layer {bindings = <
        //╭─────────────────────┬─────────────────────┬─────────────────────┬─────────────────────┬─────────────────────╮   ╭─────────────────────┬─────────────────────┬─────────────────────┬─────────────────────┬─────────────────────╮
        //│         F1          │         F2          │         F3          │         F4          │      PROFILE 0      │   │      PROFILE 3      │      TOGGLEOUT      │         WIN         │       VOL UP        │      NEXT SONG      │
                  &kp F1                &kp F2                &kp F3                &kp F4             &bt BT_SEL 0              &bt BT_SEL 3           &out OUT_TOG          &tog RU_WIN          &kp C_VOL_UP          &kp C_NEXT
        //├─────────────────────┼─────────────────────┼─────────────────────┼─────────────────────┼─────────────────────┤   ├─────────────────────┼─────────────────────┼─────────────────────┼─────────────────────┼─────────────────────┤
        //│         F5          │         F6          │         F7          │         F8          │      PROFILE 1      │   │      PROFILE 4      │      INC BRIGHT     │                     │       VOL MUTE      │     PAUSE/MUTE      │
                  &kp F5                &kp F6                &kp F7                &kp F8             &bt BT_SEL 1              &bt BT_SEL 4           &kp C_BRI_UP             &trans              &kp C_MUTE            &kp C_PP
        //├─────────────────────┼─────────────────────┼─────────────────────┼─────────────────────┼─────────────────────┤   ├─────────────────────┼─────────────────────┼─────────────────────┼─────────────────────┼─────────────────────┤
        //│         F9          │         F10         │         F11         │         F12         │      PROFILE 2      │   │      CLEAR BT       │      DEC BRIGHT     │                     │      VOL DOWN       │      PREV SONG      │
                  &kp F9                &kp F10               &kp F11               &kp F12            &bt BT_SEL 2               &bt BT_CLR           &kp C_BRI_DEC             &trans            &kp C_VOL_DN            &kp C_PREV
        //╰─────────────────────┴─────────────────────┴─────────────────────┼─────────────────────┼─────────────────────┤   ├─────────────────────┼─────────────────────┼─────────────────────┴─────────────────────┴─────────────────────╯
                                                                                     &trans               &trans                     &trans               &trans
        //                                                                  ╰─────────────────────┴─────────────────────╯   ╰─────────────────────┴─────────────────────╯
            >;
        };
    };
};
